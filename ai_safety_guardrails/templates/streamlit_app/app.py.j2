def add_safety_log(text: str, results: Dict[str, Any], blocked: bool):
    """Add entry to safety logs"""
    log_entry = {
        'timestamp': datetime.now(),
        'text': text[:100] + "..." if len(text) > 100 else text,
        'blocked': blocked,
        'results': results
    }
    st.session_state.safety_logs.append(log_entry)
    
    # Keep only last 100 logs
    if len(st.session_state.safety_logs) > 100:
        st.session_state.safety_logs = st.session_state.safety_logs[-100:]

def update_metrics(processing_time: float, blocked: bool, detector_results: Dict[str, Any]):
    """Update metrics"""
    metrics = st.session_state.metrics
    metrics['total_requests'] += 1
    if blocked:
        metrics['blocked_requests'] += 1
    
    metrics['response_times'].append(processing_time)
    if len(metrics['response_times']) > 1000:
        metrics['response_times'] = metrics['response_times'][-1000:]
    
    # Update detector stats
    for detector, result in detector_results.items():
        if detector not in metrics['detector_stats']:
            metrics['detector_stats'][detector] = {'triggered': 0, 'total': 0}
        metrics['detector_stats'][detector]['total'] += 1
        if result.get('blocked', False):
            metrics['detector_stats'][detector]['triggered'] += 1

