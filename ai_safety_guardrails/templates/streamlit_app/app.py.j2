                            st.success(f"✅ **{detector.title()}**: Safe")
                        st.caption(f"Confidence: {result.confidence:.2f}")
                
                with col2:
                    st.subheader("📈 Confidence Scores")
                    df = pd.DataFrame([
                        {'Detector': detector.title(), 'Confidence': result.confidence, 'Status': 'Blocked' if result.blocked else 'Safe'}
                        for detector, result in results.items()
                    ])
                    fig = px.bar(df, x='Detector', y='Confidence', color='Status',
                               color_discrete_map={'Blocked': 'red', 'Safe': 'green'})
                    st.plotly_chart(fig, use_container_width=True)
                
                # Update logs and metrics
                add_safety_log(text_to_check, results, blocked)
                update_metrics(processing_time, blocked, {k: {'blocked': v.blocked} for k, v in results.items()})
                
            except Exception as e:
                st.error(f"Error: {e}")

