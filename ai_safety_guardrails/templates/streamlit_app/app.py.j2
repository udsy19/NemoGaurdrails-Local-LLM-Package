                    st.success("✅ **Content Safe**")
                
                # Detailed results
                col1, col2 = st.columns(2)
                
                with col1:
                    st.subheader("📊 Detection Results")
                    for detector, result in results.items():
                        if result.blocked:
                            st.error(f"🚫 **{detector.title()}**: {result.reason}")
