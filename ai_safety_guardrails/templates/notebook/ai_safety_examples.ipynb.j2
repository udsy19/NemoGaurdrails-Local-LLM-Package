    "## 💬 Protected AI Conversations\n",
    "\n",
    "Now let's see how to have safe conversations with the LLM using the safety guardrails."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Protected chat function\n",
    "async def safe_chat(message: str, model: str = \"{{ model_default }}\"):\n",
    "    \"\"\"Have a protected conversation with the LLM\"\"\"\n",
    "    start_time = time.time()\n",
    "    \n",
    "    try:\n",
    "        {% if llm_provider == 'openai' %}\n",
    "        # Create safe chat function\n",
    "        safe_chat_fn = llm_client.create_safe_chat_function(model=model)\n",
    "        \n",
    "        # Protected execution\n",
    "        result = await safety_guard.protect(\n",
    "            input_text=message,\n",
    "            llm_function=safe_chat_fn,\n",
    "            max_tokens=150,\n",
    "            temperature=0.7\n",
    "        )\n",
    "        {% elif llm_provider == 'ollama' %}\n",
    "        # Create safe chat function\n",
    "        safe_chat_fn = llm_client.create_safe_chat_function(model=model)\n",
    "        \n",
    "        # Protected execution\n",
    "        result = await safety_guard.protect(\n",
    "            input_text=message,\n",
    "            llm_function=safe_chat_fn\n",
    "        )\n",
    "        {% elif llm_provider == '' %}\n",
    "        #  chat function\n",
    "        async def _chat(prompt: str) -> str:\n",
    "            response = await _client.messages.create(\n",
    "                model=model,\n",
    "                max_tokens=150,\n",
    "                temperature=0.7,\n",
    "                messages=[{\"role\": \"user\", \"content\": prompt}]\n",
    "            )\n",
    "            return response.content[0].text\n",
    "        \n",
    "        # Protected execution\n",
    "        result = await safety_guard.protect(\n",
    "            input_text=message,\n",
    "            llm_function=_chat\n",
    "        )\n",
    "        {% endif %}\n",
    "        \n",
    "        processing_time = time.time() - start_time\n",
    "        \n",
    "        # Display results\n",
    "        print(f\"👤 User: {message}\")\n",
    "        \n",
    "        if result.blocked:\n",
    "            print(f\"🛡️ Blocked: {result.block_reason}\")\n",
    "        else:\n",
    "            print(f\"🤖 Assistant: {result.response}\")\n",
    "        \n",
    "        print(f\"⏱️ Processing time: {processing_time:.2f}s\")\n",
    "        print(f\"📊 Safety scores: {len([r for r in result.safety_results.values() if r.blocked])} detectors triggered\")\n",
    "        \n",
    "        return result\n",
    "        \n",
    "    except Exception as e:\n",
    "        print(f\"❌ Error: {e}\")\n",
    "        return None\n",
    "\n",
    "# Test safe conversation\n",
    "print(\"🔥 Safe Conversation Test:\")\n",
    "await safe_chat(\"What is artificial intelligence and how does it work?\")"
   ]
