    "# Test different toxicity thresholds\n",
    "borderline_text = \"That's a really stupid idea and you're being dumb about it.\"\n",
    "\n",
    "print(\"🎛️ Testing Different Toxicity Thresholds:\")\n",
    "print(f\"Text: '{borderline_text}'\\n\")\n",
    "\n",
    "# Test with different configurations\n",
    "from ai_safety_guardrails import DetectorConfig\n",
    "\n",
    "thresholds = [0.3, 0.5, 0.7, 0.9]\n",
    "for threshold in thresholds:\n",
    "    # Create custom safety guard with specific threshold\n",
    "    custom_guard = SafetyGuard(detectors=[\n",
    "        DetectorConfig(\"toxicity\", threshold=threshold)\n",
    "    ])\n",
    "    \n",
    "    results = await custom_guard.analyze_text(borderline_text)\n",
    "    blocked = results['toxicity'].blocked\n",
    "    confidence = results['toxicity'].confidence\n",
    "    \n",
    "    status = \"🚫 BLOCKED\" if blocked else \"✅ ALLOWED\"\n",
    "    print(f\"Threshold {threshold}: {status} (confidence: {confidence:.3f})\")\n",
    "    \n",
    "    await custom_guard.cleanup()"
   ]
