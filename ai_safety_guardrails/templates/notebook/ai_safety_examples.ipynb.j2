    "print(\"🧪 Edge Case Testing:\")\n",
    "\n",
    "for i, test_text in enumerate(edge_cases):\n",
    "    print(f\"\\nTest {i+1}: {repr(test_text[:50])}{'...' if len(test_text) > 50 else ''}\")\n",
    "    \n",
    "    try:\n",
    "        start_time = time.time()\n",
    "        results = await safety_guard.analyze_text(test_text)\n",
    "        processing_time = time.time() - start_time\n",
    "        \n",
    "        blocked = any(result.blocked for result in results.values())\n",
    "        triggered = [name for name, result in results.items() if result.blocked]\n",
    "        \n",
    "        status = \"🚫 BLOCKED\" if blocked else \"✅ SAFE\"\n",
    "        print(f\"  Result: {status} ({processing_time:.3f}s)\")\n",
    "        if triggered:\n",
    "            print(f\"  Triggered: {', '.join(triggered)}\")\n",
    "            \n",
    "    except Exception as e:\n",
