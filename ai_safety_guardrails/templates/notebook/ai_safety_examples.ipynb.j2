    "## 🛡️ Basic Safety Analysis\n",
    "\n",
    "Let's start with basic text safety analysis to understand how the detectors work."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Helper function to display safety results\n",
    "def display_safety_results(text: str, results: Dict[str, Any]):\n",
    "    \"\"\"Display safety analysis results in a formatted way\"\"\"\n",
    "    print(f\"🔍 Analyzing: '{text[:100]}{'...' if len(text) > 100 else ''}'\")\n",
    "    print(\"\\n📊 Results:\")\n",
    "    \n",
    "    overall_blocked = any(result.blocked for result in results.values())\n",
    "    \n",
    "    if overall_blocked:\n",
    "        print(\"🚫 CONTENT BLOCKED\")\n",
    "    else:\n",
    "        print(\"✅ CONTENT SAFE\")\n",
    "    \n",
    "    print(\"\\nDetector Details:\")\n",
    "    for detector, result in results.items():\n",
    "        status = \"🚫 BLOCKED\" if result.blocked else \"✅ SAFE\"\n",
    "        print(f\"  {detector}: {status} (confidence: {result.confidence:.2f})\")\n",
    "        if result.blocked and result.reason:\n",
    "            print(f\"    Reason: {result.reason}\")\n",
    "    \n",
    "    return overall_blocked\n",
    "\n",
    "# Test with safe content\n",
    "safe_text = \"Hello! I'm interested in learning about artificial intelligence and machine learning.\"\n",
    "results = await safety_guard.analyze_text(safe_text)\n",
    "display_safety_results(safe_text, results)"
   ]
