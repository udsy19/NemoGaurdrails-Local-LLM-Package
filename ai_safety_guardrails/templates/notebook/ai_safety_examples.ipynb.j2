    "## 🎭 Using the Decorator API\n",
    "\n",
    "The decorator API provides a simpler way to add safety to existing functions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Example using the @safe_ai decorator\n",
    "{% if llm_provider == 'openai' %}\n",
    "@safe_ai(detectors=[\"toxicity\", \"pii\", \"prompt_injection\"])\n",
    "async def protected_openai_chat(message: str) -> str:\n",
    "    \"\"\"Protected OpenAI chat function using decorator\"\"\"\n",
    "    response = await llm_client.chat_completion(\n",
    "        messages=[{\"role\": \"user\", \"content\": message}],\n",
    "        model=\"{{ model_default }}\",\n",
    "        max_tokens=100\n",
