@app.post("/chat", response_model=ChatResponse)
async def chat(request: ChatRequest):
    """Protected chat endpoint with safety guardrails"""
    if not safety_guard{% if llm_provider == 'openai' %} or not llm_client{% elif llm_provider == 'ollama' %} or not llm_client{% elif llm_provider == '' %} or not _client{% endif %}:
        raise HTTPException(status_code=503, detail="Service not initialized")
    
    try:
        import time
        start_time = time.time()
        
        {% if llm_provider == 'openai' %}
        # Create safe chat function
        safe_chat = llm_client.create_safe_chat_function(model=request.model)
        
        # Protected execution
        result = await safety_guard.protect(
            input_text=request.message,
            llm_function=safe_chat,
            temperature=request.temperature,
            max_tokens=request.max_tokens
        )
        {% elif llm_provider == 'ollama' %}
        # Create safe chat function
        safe_chat = llm_client.create_safe_chat_function(model=request.model)
        
        # Protected execution
        result = await safety_guard.protect(
            input_text=request.message,
            llm_function=safe_chat
        )
        {% elif llm_provider == '' %}
        #  chat function
        async def _chat(prompt: str) -> str:
            response = await _client.messages.create(
                model=request.model,
                max_tokens=request.max_tokens,
                temperature=request.temperature,
                messages=[{"role": "user", "content": prompt}]
            )
            return response.content[0].text
        
        # Protected execution
        result = await safety_guard.protect(
            input_text=request.message,
            llm_function=_chat
        )
        {% endif %}
        
        processing_time = time.time() - start_time
        
        return ChatResponse(
            response=result.response if not result.blocked else "Request blocked for safety reasons.",
            blocked=result.blocked,
            block_reason=result.block_reason if result.blocked else None,
            safety_scores=result.safety_results,
            model_used=request.model,
            processing_time=processing_time
        )
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Chat error: {str(e)}")

@app.post("/safety-check", response_model=SafetyCheckResponse)
async def safety_check(request: SafetyCheckRequest):
    """Check text safety without LLM interaction"""
    if not safety_guard:
        raise HTTPException(status_code=503, detail="Safety guard not initialized")
    
    try:
        import time
        start_time = time.time()
        
        # Analyze text safety
        results = await safety_guard.analyze_text(
            text=request.text,
            detectors=request.detectors
        )
        
        processing_time = time.time() - start_time
        
        # Determine if blocked
        blocked = any(result.blocked for result in results.values())
        overall_confidence = max((result.confidence for result in results.values()), default=0.0)
        
        return SafetyCheckResponse(
            blocked=blocked,
            results={name: {
                "blocked": result.blocked,
                "confidence": result.confidence,
                "reason": result.reason
            } for name, result in results.items()},
            overall_confidence=overall_confidence,
            processing_time=processing_time
        )
        
    except Exception as e:
        raise HTTPException(status_code=500, detail=f"Safety check error: {str(e)}")

